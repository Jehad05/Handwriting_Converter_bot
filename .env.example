# Required at deployment; the bot exits with status 1 if this is missing.
BOT_TOKEN=

# Optional Telegram numeric user ID for premium administration; 0 disables it.
ADMIN_USER_ID=0

# Positive per-user conversions per 02:00 UTC quota window.
DAILY_LIMIT=3

# Relative paths resolve from this project directory, not the process cwd.
DATA_DIR=data
DB_PATH=data/bot.sqlite3
TEMP_DIR=data/tmp

# Shared outbound Bot API pacing; the global ceiling is capped at 25/s.
BOT_GLOBAL_SENDS_PER_SECOND=20
# Minimum spacing: private chats >=1s; group chats >=3s (20/min guidance).
BOT_PRIVATE_CHAT_INTERVAL_SECONDS=1
BOT_GROUP_CHAT_INTERVAL_SECONDS=3.05
# Separate cap for concurrent PDF conversion workers; independent of send pacing.
PDF_CONVERSION_CONCURRENCY=2
